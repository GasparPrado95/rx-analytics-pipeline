# Copy to .env and fill in. .env is git-ignored.

# --- Source: local SQL Server (Windows authentication) ---
SQL_SERVER=localhost
SQL_DATABASE=RxSource
SQL_DRIVER=ODBC Driver 18 for SQL Server
# Local dev instance uses a self-signed certificate
SQL_TRUST_SERVER_CERTIFICATE=yes

# --- Destination: Google BigQuery (Phase 2+) ---
GCP_PROJECT_ID=
BIGQUERY_LOCATION=EU
# Absolute path to the service-account JSON key, stored OUTSIDE the repo
GOOGLE_APPLICATION_CREDENTIALS=
